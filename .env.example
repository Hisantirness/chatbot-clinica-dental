GROQ_API_KEY=tu-api-key-de-groq
ADMIN_TOKEN=token-secreto-para-panel-admin
# Opcional: ruta de la base de datos (en Railway usa /data/clinica.db con un Volume montado en /data)
DB_PATH=clinica.db
# Opcional: origenes permitidos por CORS, separados por coma (default: dominio de Railway)
# CORS_ORIGINS=https://mi-dominio.com,http://localhost:3000
# Opcional: recordatorios de citas por email (si no se configuran, el job se omite sin enviar nada)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-app-password-de-gmail
# EMAIL_FROM=Sonrisa Sana <tu-correo@gmail.com>
# Opcional: intervalo del job de recordatorios en minutos (0 para desactivarlo, default: 30)
# REMINDER_INTERVAL_MINUTES=30
# Opcional: URL publica de la app (para enlaces de confirmacion/cancelacion en los correos)
# PUBLIC_BASE_URL=http://localhost:3000
# Opcional: sedes de la clinica. Formato: "Nombre Sede|Direccion;Nombre2|Direccion2"
# SEDES=Sede Norte|Avenida 6 Norte, Cali;Sede Sur|Calle 5, Cali
# Opcional: email para el boton "Enviar prueba" del panel admin
# ADMIN_EMAIL=admin@clinica.com
